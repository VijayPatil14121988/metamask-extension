{
  "name": "@shard/wallet-snap",
  "version": "1.0.0",
  "description": "MetaMask Snap for transparent wallet securitization using Shard Crypto SDK",
  "main": "bundle.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/shard/wallet-snap.git"
  },
  "license": "MIT",
  "author": "Shard Team",
  "keywords": [
    "metamask",
    "snap",
    "wallet",
    "security",
    "shamir-secret-sharing",
    "shard"
  ],
  "scripts": {
    "build": "mm-snap build",
    "build:webpack": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write 'src/**/*.{ts,json}'",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "serve": "mm-snap serve"
  },
  "dependencies": {
    "@metamask/key-tree": "^9.0.0",
    "@metamask/snaps-sdk": "^6.0.0",
    "@noble/ciphers": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "secrets.js-34r7h": "^2.0.2"
  },
  "devDependencies": {
    "@metamask/snaps-webpack-plugin": "^5.1.1",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  }
}
